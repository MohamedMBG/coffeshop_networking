<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup disabled at application level (allowBackup=false).
  Even if re-enabled later, exclude every domain by default so that
  Firebase auth tokens, FCM tokens, cached identity, and SharedPreferences
  are never copied to Google Drive backups.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
