<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-theme overrides. Only adaptive tokens appear here; anything defined in
  values/colors.xml and omitted below is intentionally identical in both themes
  (raw constants, _fixed brand tones, scrims, camera chrome).

  The brand brown is lightened rather than reused: #8B5A3C on a near-black
  surface falls under the 4.5:1 text contrast floor, so dark theme uses a
  toasted-cream tint of it and flips the on-brand content colour to espresso.
-->
<resources>

    <!-- ===== Brand ===== -->
    <color name="brand_primary">#D3A184</color>
    <color name="brand_on_primary">#3A2416</color>
    <color name="brand_primary_dark">#B4835F</color>
    <color name="brand_primary_container">#3A2A20</color>
    <color name="brand_on_primary_container">#F0DBCB</color>
    <color name="brand_accent">#F0975A</color>
    <color name="brand_accent_light">#FFC39B</color>
    <color name="brand_on_accent">#3A1D08</color>
    <color name="brand_tertiary">#C7A582</color>
    <color name="brand_gold">#F2C368</color>

    <!-- ===== Surfaces ===== -->
    <color name="surface">#17120F</color>
    <color name="surface_card">#211A16</color>
    <color name="surface_container">#1C1613</color>
    <color name="surface_muted">#221B17</color>
    <color name="outline">#362C26</color>
    <color name="outline_subtle">#33C79A7E</color>

    <!-- ===== Content ===== -->
    <color name="text_primary">#F3EAE3</color>
    <color name="text_secondary">#C2B2A6</color>
    <color name="text_tertiary">#8E7F73</color>
    <color name="text_on_brand_muted">#4A3423</color>
    <color name="icon_default">#F3EAE3</color>
    <color name="icon_muted">#8E7F73</color>

    <!-- ===== Status ===== -->
    <color name="status_success">#6ED598</color>
    <color name="status_success_container">#14301F</color>
    <color name="status_error">#FF9B94</color>
    <color name="status_error_strong">#FF7A72</color>
    <color name="status_error_container">#3A1A18</color>
    <color name="status_warning">#F0B65A</color>
    <color name="status_info">#8FB8EB</color>
    <color name="status_bonus">#F0A468</color>
    <color name="on_status">#1B1310</color>

    <!-- ===== Loyalty stamps ===== -->
    <color name="stamp_filled">#D3A184</color>
    <color name="stamp_empty">#3A302A</color>
    <color name="punch_card_highlight">#3A2E14</color>

    <!-- ===== Bottom navigation ===== -->
    <color name="nav_surface">#211A16</color>
    <color name="nav_stroke">#33C79A7E</color>
    <color name="nav_item_inactive">#C79A7E</color>
    <color name="nav_ripple">#33D3A184</color>
    <color name="nav_indicator">#3A2A20</color>
    <color name="nav_indicator_content">#E5BE9F</color>

</resources>
